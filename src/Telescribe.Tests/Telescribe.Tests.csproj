<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The tests deliberately use the default cancellation token. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Telescribe.Core\Telescribe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Telescribe.Console\templates\**\*" LinkBase="templates" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
